---
// Git logo, same artwork as the app's ic_git_repo.xml drawable
const gitIcon = `<svg viewBox="0 0 256 256" fill="#DE4C36"><path d="M251.172,116.594 L139.4,4.828 C132.967,-1.609 122.527,-1.609 116.086,4.828 L92.876,28.038 L122.319,57.481 C129.161,55.169 137.007,56.72 142.461,62.174 C147.941,67.663 149.481,75.576 147.113,82.44 L175.488,110.816 C182.353,108.451 190.274,109.981 195.757,115.473 C203.42,123.133 203.42,135.548 195.757,143.213 C188.092,150.879 175.677,150.879 167.908,143.213 C162.144,137.443 160.72,128.978 163.638,121.877 L137.176,95.415 L137.173,165.052 C140.231,166.012 143.086,167.632 145.452,169.998 C153.115,177.658 153.115,190.074 145.452,197.745 C137.787,205.407 125.366,205.407 117.712,197.745 C110.049,190.074 110.049,177.659 117.712,169.999 C120.404,167.307 123.75,165.522 127.323,164.631 L127.323,94.196 C124.631,93.305 121.285,91.52 118.593,88.828 C112.787,83.03 111.391,74.511 114.366,67.382 L81.47,39.442 L4.83,116.077 C-1.61,122.52 -1.61,132.961 4.83,139.399 L116.604,251.167 C123.039,257.605 133.477,257.605 139.92,251.167 L251.171,139.918 C257.609,133.478 257.609,123.031 251.172,116.594 Z"/></svg>`;

const features = [
  {
    icon: '🤖',
    title: 'Agentic AI chat',
    text: 'Chat with local or remote models that can read, edit and run your code. Every change is tracked with one-click Keep / Undo.',
  },
  {
    icon: '🧠',
    title: 'Models management',
    text: 'Configure, monitor and switch between model providers. Local-first — remote providers are optional and user-chosen.',
  },
  {
    icon: '🔌',
    title: 'MCP integration',
    text: 'Connect Model Context Protocol tool servers and expose workspace skills to your agents.',
  },
  {
    icon: '⌨️',
    title: 'Built-in terminal',
    text: 'A real Linux-like shell powered by Termux. Install packages, run build tools, keep servers alive in the background.',
  },
  {
    svg: gitIcon,
    title: 'Git, built in',
    text: 'Status, branches, staging, stash, commit history, in-editor diffs with hunk accept/revert and a visual conflict editor.',
  },
  {
    icon: '🌐',
    title: 'Agentic browser',
    text: 'Test your work and automate the web through a built-in WebView driven by Chrome DevTools Protocol and a dedicated MCP server.',
  },
  {
    icon: '📝',
    title: 'Code editor',
    text: 'TextMate syntax highlighting, word wrap, diff overlays and a log viewer with filtering, search and export.',
  },
  {
    icon: '🛡️',
    title: 'Permissions & workspace guard',
    text: 'Granular control over system permissions, plus workspace boundary scoping so agents only touch what you allow.',
  },
];
---

<section id="features" class="section">
  <div class="container">
    <div class="section-head">
      <span class="badge badge-teal">Features</span>
      <h2>Everything you need to ship from your pocket</h2>
      <p>A self-contained development environment — editor, terminal, Git, AI and browser — in one native app.</p>
    </div>
    <div class="grid">
      {
        features.map((f) => (
          <article class="card feature">
            <div class="icon" aria-hidden="true">
              {'svg' in f ? <Fragment set:html={f.svg} /> : f.icon}
            </div>
            <h3>{f.title}</h3>
            <p class="muted">{f.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }
  .feature h3 {
    font-size: 1.1rem;
    margin: 0.75rem 0 0.4rem;
  }
  .feature p {
    margin: 0;
    font-size: 0.95rem;
  }
  .icon {
    font-size: 1.6rem;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
  }
  .icon :global(svg) {
    width: 26px;
    height: 26px;
  }
</style>
