---
import { site, repoUrl } from '../config';

const links = [
  { href: '/#features', label: 'Features' },
  { href: '/#principles', label: 'Principles' },
  { href: '/downloads', label: 'Downloads' },
  { href: '/#build', label: 'Build' },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <img
        src="/images/logo-lockup.png"
        alt={`${site.name} — Mobile-first agentic IDE`}
        width="487"
        height="96"
        decoding="async"
      />
    </a>
    <nav aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={repoUrl} target="_blank" rel="noopener" class="gh" aria-label="GitHub repository">
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(13, 13, 15, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 1rem;
  }
  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand img {
    height: 44px;
    width: auto;
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  nav a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }
  nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .gh {
    display: inline-flex;
  }
  @media (max-width: 640px) {
    .brand img {
      height: 36px;
    }
    nav a:not(.gh):not([href='/downloads']) {
      display: none;
    }
  }
</style>
