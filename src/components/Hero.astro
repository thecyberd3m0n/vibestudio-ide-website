---
import { site, repoUrl, withBase } from '../config';
import type { Release } from '../lib/releases';

interface Props {
  latest: Release | null;
}
const { latest } = Astro.props;
const apk = latest?.assets[0];
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="badge badge-purple">Early access · <span data-release="tag">{latest ? latest.tag : 'v0.1.x'}</span></span>
      <h1>
        A full IDE on your phone.<br />
        <span class="accent">Nothing leaves the device.</span>
      </h1>
      <p class="lead">
        VibeStudio is a native Android IDE with a built-in terminal, Git, an agentic AI chat and a
        browser with MCP tooling — running entirely on-device. Think <em>VS Code, but mobile</em>.
      </p>
      <div class="cta">
        <a href={apk ? apk.url : withBase('/downloads')} class="btn btn-primary" data-release="apk-url">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
          </svg>
          Download APK
        </a>
        <a href={withBase('/downloads')} class="btn btn-secondary">Soon on F-Droid</a>
        <a href={repoUrl} class="btn btn-ghost" target="_blank" rel="noopener">View on GitHub</a>
      </div>
      <p class="meta muted">
        Requires {site.minAndroid} · {site.arch} · Free &amp; open source
      </p>
    </div>

    <div
      class="hero-media"
      data-phone-stage
      role="img"
      aria-label="VibeStudio IDE demo on a phone: coding with an AI agent, terminal and Git"
    >
      <canvas class="phone-canvas"></canvas>
      <!-- Screen recording shown on the 3D phone's display; also the fallback when WebGL is unavailable -->
      <div class="phone-fallback">
        <video class="phone-video" autoplay muted loop playsinline preload="auto" disablepictureinpicture>
          <source src={withBase('/video/phone-demo.mp4')} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  import { hydrateLatest } from '../scripts/releases-client';
  import { createPhoneScene } from '../scripts/phone-scene';

  hydrateLatest();

  const stage = document.querySelector<HTMLElement>('[data-phone-stage]');
  const canvas = stage?.querySelector<HTMLCanvasElement>('.phone-canvas');
  const video = stage?.querySelector<HTMLVideoElement>('.phone-video');

  if (stage && canvas && video) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const showFallback = () => stage.classList.add('is-fallback');

    const probe = document.createElement('canvas');
    const webgl = probe.getContext('webgl2') ?? probe.getContext('webgl');
    if (!webgl) {
      showFallback();
    } else {
      createPhoneScene({
        stage,
        canvas,
        video,
        modelUrl: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/models/smartphone.glb`,
        reducedMotion,
        onReady: () => stage.classList.add('is-ready'),
        onError: (error) => {
          console.error('[hero] phone scene failed, using video fallback', error);
          showFallback();
        },
      });
    }
  }
</script>

<style>
  .hero {
    padding: 5rem 0 3rem;
    background:
      radial-gradient(60% 50% at 20% 0%, var(--teal-dim), transparent 70%),
      radial-gradient(50% 50% at 90% 20%, var(--purple-dim), transparent 70%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2.5rem;
    align-items: center;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin: 1rem 0;
  }
  .accent {
    background: linear-gradient(90deg, var(--teal), var(--purple));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 560px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.75rem 0 1rem;
  }
  .meta {
    font-size: 0.9rem;
  }

  .hero-media {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 4 / 5;
    margin: 0 auto;
    background: radial-gradient(ellipse at 50% 50%, rgba(32, 201, 177, 0.22) 0%, rgba(13, 13, 15, 0) 55%);
  }
  .phone-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .hero-media.is-ready .phone-canvas {
    opacity: 1;
  }
  /* The video stays in the DOM (it feeds the WebGL texture) but is only shown as a fallback */
  .phone-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    pointer-events: none;
  }
  .phone-video {
    width: 1px;
    height: 1px;
    display: block;
  }
  .hero-media.is-fallback .phone-canvas {
    display: none;
  }
  .hero-media.is-fallback .phone-fallback {
    opacity: 1;
    pointer-events: auto;
  }
  .hero-media.is-fallback .phone-video {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: auto;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
    border: 8px solid #1b1b20;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .hero-media {
      order: -1;
      max-width: 340px;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 3rem;
    }
  }
</style>
